<dialog
  id="checkout-modal"
  aria-labelledby="checkout-title"
  class="fixed inset-0 m-auto h-[min(92dvh,900px)] w-[min(94vw,1100px)] max-w-none overflow-hidden border-0 bg-transparent p-0 backdrop:bg-slate-950/70"
>
  <div class="flex h-full flex-col overflow-hidden rounded-2xl bg-white shadow-2xl">
    <header class="flex items-center justify-between border-b border-slate-200 px-5 py-4 sm:px-8">
      <div>
        <p class="text-[10px] font-semibold uppercase tracking-[0.2em] text-violet-600">
          Reboot Lab
        </p>
        <h2 id="checkout-title" class="mt-1 text-2xl font-bold tracking-tight text-slate-950">
          Secure checkout
        </h2>
      </div>

      <button
        type="button"
        data-checkout-close
        aria-label="Close checkout"
        class="flex size-10 items-center justify-center rounded-full border border-slate-200 text-xl text-slate-500 transition hover:border-violet-300 hover:bg-violet-50 hover:text-violet-600"
      >
        ×
      </button>
    </header>

    <div class="grid min-h-0 flex-1 overflow-y-auto lg:grid-cols-[1fr_390px]">
      <form data-checkout-form class="space-y-8 p-5 sm:p-8">
        <section>
          <div class="mb-4 flex items-center gap-3">
            <span class="flex size-7 items-center justify-center rounded-full bg-violet-600 text-xs font-bold text-white">1</span>
            <h3 class="font-bold text-slate-950">Contact</h3>
          </div>

          <label class="block text-xs font-semibold text-slate-600">
            Email address
            <input
              type="email"
              name="email"
              required
              autocomplete="email"
              placeholder="you@example.com"
              class="mt-2 w-full rounded-xl border border-slate-200 px-4 py-3 text-sm outline-none transition placeholder:text-slate-400 focus:border-violet-500 focus:ring-3 focus:ring-violet-100"
            />
          </label>
        </section>

        <section>
          <div class="mb-4 flex items-center gap-3">
            <span class="flex size-7 items-center justify-center rounded-full bg-violet-600 text-xs font-bold text-white">2</span>
            <h3 class="font-bold text-slate-950">Shipping address</h3>
          </div>

          <div class="grid gap-4 sm:grid-cols-2">
            <label class="block text-xs font-semibold text-slate-600">
              First name
              <input type="text" name="firstName" required autocomplete="given-name" class="mt-2 w-full rounded-xl border border-slate-200 px-4 py-3 text-sm outline-none transition focus:border-violet-500 focus:ring-3 focus:ring-violet-100" />
            </label>
            <label class="block text-xs font-semibold text-slate-600">
              Last name
              <input type="text" name="lastName" required autocomplete="family-name" class="mt-2 w-full rounded-xl border border-slate-200 px-4 py-3 text-sm outline-none transition focus:border-violet-500 focus:ring-3 focus:ring-violet-100" />
            </label>
            <label class="block text-xs font-semibold text-slate-600 sm:col-span-2">
              Address
              <input type="text" name="address" required autocomplete="street-address" class="mt-2 w-full rounded-xl border border-slate-200 px-4 py-3 text-sm outline-none transition focus:border-violet-500 focus:ring-3 focus:ring-violet-100" />
            </label>
            <label class="block text-xs font-semibold text-slate-600">
              City
              <input type="text" name="city" required autocomplete="address-level2" class="mt-2 w-full rounded-xl border border-slate-200 px-4 py-3 text-sm outline-none transition focus:border-violet-500 focus:ring-3 focus:ring-violet-100" />
            </label>
            <label class="block text-xs font-semibold text-slate-600">
              Postal code
              <input type="text" name="postalCode" required autocomplete="postal-code" class="mt-2 w-full rounded-xl border border-slate-200 px-4 py-3 text-sm outline-none transition focus:border-violet-500 focus:ring-3 focus:ring-violet-100" />
            </label>
          </div>
        </section>

        <section>
          <div class="mb-4 flex items-center gap-3">
            <span class="flex size-7 items-center justify-center rounded-full bg-violet-600 text-xs font-bold text-white">3</span>
            <h3 class="font-bold text-slate-950">Payment</h3>
          </div>

          <div class="rounded-xl border border-violet-200 bg-violet-50 p-4 text-sm leading-6 text-violet-900">
            Payment processing will be connected here. No card information is collected yet.
          </div>
        </section>

        <button
          type="submit"
          class="flex w-full items-center justify-between rounded-xl bg-violet-600 px-6 py-4 text-sm font-semibold text-white transition hover:bg-violet-700"
        >
          <span>Continue to payment</span>
          <span>→</span>
        </button>

        <p data-checkout-message class="hidden rounded-xl bg-emerald-50 p-4 text-sm font-medium text-emerald-700" role="status">
          Your information is ready. Connect a payment provider to complete the order.
        </p>
      </form>

      <aside class="border-t border-slate-200 bg-slate-50 p-5 sm:p-8 lg:border-l lg:border-t-0">
        <h3 class="text-lg font-bold text-slate-950">Order summary</h3>
        <div data-checkout-items class="mt-5 space-y-4"></div>

        <div class="mt-6 space-y-3 border-t border-slate-200 pt-5 text-sm">
          <div class="flex justify-between text-slate-500">
            <span>Shipping</span>
            <span class="font-semibold text-emerald-600">Free</span>
          </div>
          <div class="flex items-end justify-between border-t border-slate-200 pt-4">
            <span class="font-semibold text-slate-700">Total</span>
            <strong data-checkout-total class="text-2xl text-slate-950">CHF 0.00</strong>
          </div>
        </div>

        <button type="button" data-checkout-back class="mt-7 text-sm font-semibold text-violet-600 hover:text-violet-800">
          ← Return to cart
        </button>
      </aside>
    </div>
  </div>
</dialog>

<script>
  import type { CartItem } from "../types/cart";

  const checkoutModal = document.querySelector<HTMLDialogElement>("#checkout-modal");
  const checkoutItems = checkoutModal?.querySelector<HTMLElement>("[data-checkout-items]");
  const checkoutTotal = checkoutModal?.querySelector<HTMLElement>("[data-checkout-total]");
  const checkoutForm = checkoutModal?.querySelector<HTMLFormElement>("[data-checkout-form]");
  const checkoutMessage = checkoutModal?.querySelector<HTMLElement>("[data-checkout-message]");
  const checkoutCurrency = new Intl.NumberFormat("de-CH", {
    style: "currency",
    currency: "CHF",
    maximumFractionDigits: 2,
  });

  function getCheckoutCart(): CartItem[] {
    try {
      const cart = JSON.parse(localStorage.getItem("reboot-lab-cart") ?? "[]");
      return Array.isArray(cart) ? cart : [];
    } catch {
      return [];
    }
  }

  function renderCheckout() {
    const cart = getCheckoutCart();
    checkoutItems?.replaceChildren();

    cart.forEach((item) => {
      const row = document.createElement("article");
      row.className = "flex items-center gap-3";

      const imageWrapper = document.createElement("div");
      imageWrapper.className = "relative size-16 shrink-0 overflow-hidden rounded-lg bg-white";

      const image = document.createElement("img");
      image.src = item.image;
      image.alt = item.name;
      image.className = "size-full object-cover";

      const quantity = document.createElement("span");
      quantity.textContent = String(item.quantity);
      quantity.className = "absolute right-1 top-1 flex size-5 items-center justify-center rounded-full bg-slate-950 text-[10px] font-bold text-white";

      const information = document.createElement("div");
      information.className = "min-w-0 flex-1";

      const name = document.createElement("p");
      name.textContent = item.name;
      name.className = "truncate text-sm font-semibold text-slate-950";

      const price = document.createElement("p");
      price.textContent = checkoutCurrency.format(item.price * item.quantity);
      price.className = "mt-1 text-xs font-medium text-slate-500";

      imageWrapper.append(image, quantity);
      information.append(name, price);
      row.append(imageWrapper, information);
      checkoutItems?.append(row);
    });

    const total = cart.reduce((sum, item) => sum + item.price * item.quantity, 0);
    if (checkoutTotal) checkoutTotal.textContent = checkoutCurrency.format(total);
  }

  window.addEventListener("checkout:open", () => {
    renderCheckout();
    checkoutMessage?.classList.add("hidden");
    checkoutModal?.showModal();
  });

  checkoutModal?.querySelectorAll<HTMLElement>("[data-checkout-close]").forEach((button) => {
    button.addEventListener("click", () => checkoutModal.close());
  });

  checkoutModal?.querySelector<HTMLElement>("[data-checkout-back]")?.addEventListener("click", () => {
    checkoutModal.close();
    window.dispatchEvent(new CustomEvent("cart:open"));
  });

  checkoutModal?.addEventListener("click", (event) => {
    if (event.target === checkoutModal) checkoutModal.close();
  });

  checkoutForm?.addEventListener("submit", (event) => {
    event.preventDefault();
    checkoutMessage?.classList.remove("hidden");
    checkoutMessage?.scrollIntoView({ behavior: "smooth", block: "nearest" });
    window.dispatchEvent(
      new CustomEvent("reboot:notify", {
        detail: {
          type: "info",
          message: "Checkout details validated. Payment is not connected yet.",
        },
      }),
    );
  });
</script>
