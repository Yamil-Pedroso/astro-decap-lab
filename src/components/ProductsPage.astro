---
import ProductCard from "./ProductCard.astro";
import { categories } from "../data/categories";
import { products } from "../data/products";
---

<section class="py-10 lg:py-16">
  <div class="grid overflow-hidden rounded-3xl bg-[#08080f] text-white lg:grid-cols-[1.25fr_0.75fr]">
    <div class="p-8 sm:p-12 lg:p-16">
      <p class="text-xs font-semibold uppercase tracking-[0.22em] text-violet-400">Shop the lab</p>
      <h1 class="mt-5 max-w-3xl text-5xl font-bold tracking-tight sm:text-6xl">Tested hardware, ready for its next cycle.</h1>
      <p class="mt-6 max-w-2xl text-base leading-7 text-slate-300">Browse every refurbished product currently available at Reboot Lab. Clear pricing, dependable hardware and no unnecessary replacements.</p>
    </div>

    <div class="grid grid-cols-2 border-t border-white/10 lg:border-l lg:border-t-0">
      <div class="flex flex-col justify-end border-b border-r border-white/10 p-7">
        <strong class="text-5xl text-violet-400">{products.length}</strong>
        <span class="mt-2 text-xs uppercase tracking-[0.18em] text-slate-400">Products</span>
      </div>
      <div class="flex flex-col justify-end border-b border-white/10 p-7">
        <strong class="text-5xl text-violet-400">{categories.length}</strong>
        <span class="mt-2 text-xs uppercase tracking-[0.18em] text-slate-400">Categories</span>
      </div>
      <div class="col-span-2 flex items-end p-7">
        <p class="text-sm leading-6 text-slate-400">Every device is selected to remain useful, reliable and repairable.</p>
      </div>
    </div>
  </div>

  <div class="mb-7 mt-12 flex flex-wrap items-end justify-between gap-4">
    <div>
      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-violet-600">Current inventory</p>
      <h2 class="mt-2 text-3xl font-bold tracking-tight text-slate-950">All products</h2>
    </div>
    <a href="/categories" class="text-sm font-semibold text-violet-600 hover:text-violet-800">Browse categories →</a>
  </div>

  <div class="grid gap-5 sm:grid-cols-2 xl:grid-cols-4">
    {products.map((product) => <ProductCard product={product} />)}
  </div>
</section>
