---
import { getImage, Image } from "astro:assets";
import type { ProductCardProps } from "../types/product";

type Props = ProductCardProps;

const { product } = Astro.props;
const cartImage = await getImage({
  src: product.image,
  width: 320,
  height: 240,
  fit: "cover",
  format: "webp",
});
---

<article class="border border-slate-200 bg-white">
  <div class="grid lg:grid-cols-2">
    <!-- Product image -->
    <div class="relative overflow-hidden bg-[#111114]">
      <Image
        src={product.image}
        alt={product.name}
        class="block min-h-105 w-full object-cover lg:h-full lg:min-h-155"
      />

      <div
        class="absolute bottom-5 left-5 bg-black/70 px-3 py-2 text-[10px] font-semibold uppercase tracking-[0.2em] text-white backdrop-blur"
      >
        Refurbished hardware
      </div>
    </div>

    <!-- Product information -->
    <div class="flex flex-col p-6 sm:p-10 lg:p-12">
      <div class="flex items-center justify-between gap-4">
        <p
          class="text-xs font-semibold uppercase tracking-[0.22em] text-violet-600"
        >
          {product.category}
        </p>

        <p class="text-[11px] uppercase tracking-[0.18em] text-slate-400">
          /{product.slug}
        </p>
      </div>

      <h1
        class="mt-8 text-4xl font-bold tracking-tight text-slate-950 sm:text-5xl"
      >
        {product.name}
      </h1>

      <p class="mt-6 max-w-xl text-base leading-7 text-slate-500">
        {product.description}
      </p>

      <div class="mt-10 border-y border-slate-200 py-7">
        <p
          class="text-[11px] font-semibold uppercase tracking-[0.2em] text-slate-400"
        >
          Price
        </p>

        <p class="mt-2 text-4xl font-bold tracking-tight text-slate-950">
          CHF {product.price}
        </p>
      </div>

      <div class="mt-auto pt-10">
        <div class="mb-6 flex items-center gap-3 text-sm">
          <span class="h-2 w-2 rounded-full bg-emerald-500"></span>
          <span class="font-medium text-slate-700"> Available </span>
        </div>

        <button
          type="button"
          data-add-to-cart
          data-product-slug={product.slug}
          data-product-name={product.name}
          data-product-price={product.price}
          data-product-image={cartImage.src}
          class="flex w-full items-center justify-between bg-violet-600 px-6 py-4 text-sm font-semibold text-white transition hover:bg-violet-700"
        >
          <span>Add to cart</span>
          <span>→</span>
        </button>
      </div>
    </div>
  </div>

  <!-- Technical strip -->
  <div class="grid border-t border-slate-200 sm:grid-cols-3">
    <div class="border-b border-slate-200 p-6 sm:border-b-0 sm:border-r">
      <p
        class="text-[10px] font-semibold uppercase tracking-[0.2em] text-slate-400"
      >
        Category
      </p>
      <p class="mt-2 font-medium text-slate-950">
        {product.category}
      </p>
    </div>

    <div class="border-b border-slate-200 p-6 sm:border-b-0 sm:border-r">
      <p
        class="text-[10px] font-semibold uppercase tracking-[0.2em] text-slate-400"
      >
        Condition
      </p>
      <p class="mt-2 font-medium text-slate-950">Refurbished</p>
    </div>

    <div class="p-6">
      <p
        class="text-[10px] font-semibold uppercase tracking-[0.2em] text-slate-400"
      >
        Product ID
      </p>
      <p class="mt-2 font-medium text-slate-950">
        {product.slug}
      </p>
    </div>
  </div>
</article>

<script>
  document.querySelectorAll<HTMLButtonElement>("[data-add-to-cart]").forEach((button) => {
    button.addEventListener("click", () => {
      const { productSlug, productName, productPrice, productImage } = button.dataset;

      if (!productSlug || !productName || !productPrice || !productImage) return;

      window.dispatchEvent(
        new CustomEvent("cart:add", {
          detail: {
            slug: productSlug,
            name: productName,
            price: Number(productPrice),
            image: productImage,
          },
        }),
      );
    });
  });
</script>
