---
import { Image } from "astro:assets";
import assets from "../assets";
import { aboutValues } from "../data/about";
---

<section class="py-10 lg:py-16">
  <div
    class="grid overflow-hidden rounded-3xl bg-[#08080f] text-white lg:grid-cols-2"
  >
    <div class="flex flex-col justify-center p-8 sm:p-12 lg:p-16">
      <p
        class="text-xs font-semibold uppercase tracking-[0.22em] text-violet-400"
      >
        About Reboot Lab
      </p>
      <h1
        class="mt-5 max-w-2xl text-5xl font-bold tracking-tight sm:text-6xl"
      >
        Good hardware deserves another cycle.
      </h1>
      <p class="mt-6 max-w-xl text-base leading-7 text-slate-300">
        Reboot Lab is a fictional refurbished technology shop and an
        architecture laboratory for learning how modern, content-driven web
        projects are designed, built and deployed.
      </p>
    </div>

    <div class="relative min-h-96 overflow-hidden">
      <Image
        src={assets.hero1}
        alt="Refurbished technology illuminated with violet light"
        class="absolute inset-0 h-full w-full object-cover"
      />
      <div
        class="absolute inset-0 bg-linear-to-r from-[#08080f] via-transparent to-transparent"
      >
      </div>
    </div>
  </div>

  <div class="grid gap-10 py-16 lg:grid-cols-2 lg:gap-20">
    <div>
      <p
        class="text-xs font-semibold uppercase tracking-[0.22em] text-violet-600"
      >
        The idea
      </p>
      <h2 class="mt-4 text-4xl font-bold tracking-tight text-slate-950">
        Technology can remain useful for much longer.
      </h2>
    </div>

    <div class="space-y-5 text-base leading-8 text-slate-600">
      <p>
        Computers and components are often replaced while they still have
        years of productive life ahead. Reboot Lab explores a more deliberate
        model: inspect, repair, reuse and return capable hardware to service.
      </p>
      <p>
        The project is also being developed incrementally as a practical lab
        for Astro, Git-managed content, Decap CMS and modern deployment
        workflows. Every layer is introduced with a clear architectural reason.
      </p>
    </div>
  </div>

  <div class="grid overflow-hidden rounded-2xl bg-violet-600 text-white sm:grid-cols-3">
    <div class="border-b border-white/15 p-7 sm:border-b-0 sm:border-r">
      <p class="text-4xl font-bold">100%</p>
      <p class="mt-2 text-xs uppercase tracking-[0.18em] text-violet-200">
        Static-first
      </p>
    </div>
    <div class="border-b border-white/15 p-7 sm:border-b-0 sm:border-r">
      <p class="text-4xl font-bold">4</p>
      <p class="mt-2 text-xs uppercase tracking-[0.18em] text-violet-200">
        Hardware categories
      </p>
    </div>
    <div class="p-7">
      <p class="text-4xl font-bold">1</p>
      <p class="mt-2 text-xs uppercase tracking-[0.18em] text-violet-200">
        Shared mission
      </p>
    </div>
  </div>

  <div class="py-16">
    <p
      class="text-xs font-semibold uppercase tracking-[0.22em] text-violet-600"
    >
      Principles
    </p>
    <h2 class="mt-4 text-4xl font-bold tracking-tight text-slate-950">
      How the lab thinks.
    </h2>

    <div class="mt-8 grid gap-4 md:grid-cols-3">
      {
        aboutValues.map((value) => (
          <article class="border border-slate-200 bg-white p-7">
            <span class="text-xs font-bold text-violet-600">/{value.number}</span>
            <h3 class="mt-10 text-2xl font-bold tracking-tight text-slate-950">
              {value.title}
            </h3>
            <p class="mt-3 text-sm leading-6 text-slate-500">
              {value.description}
            </p>
          </article>
        ))
      }
    </div>
  </div>
</section>
