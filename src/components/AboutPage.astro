---
import { Image } from "astro:assets";
import { getEntry } from "astro:content";

const page = await getEntry("pages", "about");
if (!page || page.data.template !== "about") throw new Error("About content not found");
const content = page.data;
---

<section class="py-10 lg:py-16">
  <div
    class="grid overflow-hidden rounded-3xl bg-[#08080f] text-white lg:grid-cols-2"
  >
    <div class="flex flex-col justify-center p-8 sm:p-12 lg:p-16">
      <p
        class="text-xs font-semibold uppercase tracking-[0.22em] text-violet-400"
      >
        {content.eyebrow}
      </p>
      <h1
        class="mt-5 max-w-2xl text-5xl font-bold tracking-tight sm:text-6xl"
      >
        {content.title}
      </h1>
      <p class="mt-6 max-w-xl text-base leading-7 text-slate-300">
        {content.description}
      </p>
    </div>

    <div class="relative min-h-96 overflow-hidden">
      <Image
        src={content.image}
        alt={content.imageAlt}
        class="absolute inset-0 h-full w-full object-cover"
      />
      <div
        class="absolute inset-0 bg-linear-to-r from-[#08080f] via-transparent to-transparent"
      >
      </div>
    </div>
  </div>

  <div class="grid gap-10 py-16 lg:grid-cols-2 lg:gap-20">
    <div>
      <p
        class="text-xs font-semibold uppercase tracking-[0.22em] text-violet-600"
      >
        {content.ideaEyebrow}
      </p>
      <h2 class="mt-4 text-4xl font-bold tracking-tight text-slate-950">
        {content.ideaTitle}
      </h2>
    </div>

    <div class="space-y-5 text-base leading-8 text-slate-600">
      {content.ideaParagraphs.map((paragraph) => <p>{paragraph}</p>)}
    </div>
  </div>

  <div class="grid overflow-hidden rounded-2xl bg-violet-600 text-white sm:grid-cols-3">
    {content.stats.map((stat, index) => (
      <div class:list={[
        "p-7",
        index < content.stats.length - 1 && "border-b border-white/15 sm:border-b-0 sm:border-r",
      ]}>
        <p class="text-4xl font-bold">{stat.value}</p>
        <p class="mt-2 text-xs uppercase tracking-[0.18em] text-violet-200">{stat.label}</p>
      </div>
    ))}
  </div>

  <div class="py-16">
    <p
      class="text-xs font-semibold uppercase tracking-[0.22em] text-violet-600"
    >
      {content.principlesEyebrow}
    </p>
    <h2 class="mt-4 text-4xl font-bold tracking-tight text-slate-950">
      {content.principlesTitle}
    </h2>

    <div class="mt-8 grid gap-4 md:grid-cols-3">
      {
        content.principles.map((value) => (
          <article class="border border-slate-200 bg-white p-7">
            <span class="text-xs font-bold text-violet-600">/{value.number}</span>
            <h3 class="mt-10 text-2xl font-bold tracking-tight text-slate-950">
              {value.title}
            </h3>
            <p class="mt-3 text-sm leading-6 text-slate-500">
              {value.description}
            </p>
          </article>
        ))
      }
    </div>
  </div>
</section>
