---
import { contactTopics } from "../data/contact";
import { getEntry } from "astro:content";

const page = await getEntry("pages", "contact");
if (!page || page.data.template !== "contact") throw new Error("Contact content not found");
const content = page.data;
---

<section class="py-10 lg:py-16">
  <div class="grid overflow-hidden rounded-3xl bg-[#08080f] text-white lg:grid-cols-[0.8fr_1.2fr]">
    <div class="flex flex-col justify-between p-8 sm:p-12 lg:p-14">
      <div>
        <p class="text-xs font-semibold uppercase tracking-[0.22em] text-violet-400">{content.eyebrow}</p>
        <h1 class="mt-5 text-5xl font-bold tracking-tight sm:text-6xl">{content.title}</h1>
        <p class="mt-6 max-w-lg text-base leading-7 text-slate-300">{content.description}</p>
      </div>

      <div class="mt-12 space-y-5 border-t border-white/10 pt-8 text-sm">
        <div>
          <p class="text-xs uppercase tracking-[0.18em] text-slate-500">Email</p>
          <a href={`mailto:${content.email}`} class="mt-1 inline-block font-semibold text-white hover:text-violet-400">{content.email}</a>
        </div>
        <div>
          <p class="text-xs uppercase tracking-[0.18em] text-slate-500">Response time</p>
          <p class="mt-1 font-semibold">{content.responseTime}</p>
        </div>
      </div>
    </div>

    <div class="bg-white p-6 text-slate-950 sm:p-10 lg:p-12">
      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-violet-600">{content.formEyebrow}</p>
      <h2 class="mt-2 text-3xl font-bold tracking-tight">{content.formTitle}</h2>

      <form data-contact-form class="mt-8 grid gap-5 sm:grid-cols-2">
        <label class="text-xs font-semibold text-slate-600">
          Your name
          <input required name="name" autocomplete="name" class="mt-2 w-full rounded-xl border border-slate-200 px-4 py-3 text-sm outline-none transition focus:border-violet-500 focus:ring-3 focus:ring-violet-100" />
        </label>
        <label class="text-xs font-semibold text-slate-600">
          Email address
          <input required type="email" name="email" autocomplete="email" class="mt-2 w-full rounded-xl border border-slate-200 px-4 py-3 text-sm outline-none transition focus:border-violet-500 focus:ring-3 focus:ring-violet-100" />
        </label>
        <label class="text-xs font-semibold text-slate-600 sm:col-span-2">
          Topic
          <select name="topic" class="mt-2 w-full rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm outline-none transition focus:border-violet-500 focus:ring-3 focus:ring-violet-100">
            {contactTopics.map((topic) => (
              <option value={topic.value}>{topic.label}</option>
            ))}
          </select>
        </label>
        <label class="text-xs font-semibold text-slate-600 sm:col-span-2">
          Message
          <textarea required name="message" rows="6" placeholder="Tell us what you need..." class="mt-2 w-full resize-y rounded-xl border border-slate-200 px-4 py-3 text-sm outline-none transition placeholder:text-slate-400 focus:border-violet-500 focus:ring-3 focus:ring-violet-100"></textarea>
        </label>
        <button type="submit" class="flex items-center justify-between rounded-xl bg-violet-600 px-6 py-4 text-sm font-semibold text-white transition hover:bg-violet-700 sm:col-span-2">
          <span>Send message</span><span>→</span>
        </button>
        <p data-contact-status class="hidden rounded-xl bg-violet-50 p-4 text-sm font-medium text-violet-700 sm:col-span-2" role="status">The form UI is ready. Connect a form endpoint to receive messages.</p>
      </form>
    </div>
  </div>
</section>

<script>
  const contactForm = document.querySelector<HTMLFormElement>("[data-contact-form]");
  const contactStatus = document.querySelector<HTMLElement>("[data-contact-status]");

  contactForm?.addEventListener("submit", (event) => {
    event.preventDefault();
    contactStatus?.classList.remove("hidden");
    window.dispatchEvent(new CustomEvent("reboot:notify", {
      detail: {
        type: "info",
        message: "Form validated. Message delivery is not connected yet.",
      },
    }));
  });
</script>
