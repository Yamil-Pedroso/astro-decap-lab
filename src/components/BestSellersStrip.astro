---
import { Image } from "astro:assets";
import { getCollection, getEntry } from "astro:content";
import { withBasePath } from "../utils/paths";

const [entries, page] = await Promise.all([
  getCollection("products"),
  getEntry("pages", "home"),
]);
if (!page || page.data.template !== "home") throw new Error("Home content not found");
const productsBySlug = new Map(
  entries.map((entry) => [entry.id, { slug: entry.id, ...entry.data }]),
);
const content = page.data.bestSellers;
const bestSellers = content.products.flatMap((slug) => {
  const product = productsBySlug.get(slug);
  return product ? [product] : [];
});
---

<section class="mt-12" aria-labelledby="best-sellers-title">
  <div class="mb-4 flex items-end justify-between gap-4">
    <div>
      <p
        class="text-[10px] font-semibold uppercase tracking-[0.2em] text-violet-600"
      >
        {content.eyebrow}
      </p>
      <h2
        id="best-sellers-title"
        class="mt-2 text-2xl font-bold tracking-tight text-slate-950"
      >
        {content.title}
      </h2>
    </div>

    <a
      href={withBasePath("/products")}
      class="text-xs font-semibold text-slate-500 transition hover:text-violet-600"
    >
      {content.viewAll}
    </a>
  </div>

  <div
    class="flex snap-x snap-mandatory overflow-x-auto rounded-2xl bg-[#08080f] text-white"
  >
    {
      bestSellers.map((product, index) => (
        <article
          class:list={[
            "group relative min-w-60 flex-1 snap-start p-4",
            index > 0 && "border-l border-white/10",
          ]}
        >
          <div class="mb-3 flex items-center justify-between gap-3">
            <span class="text-2xl font-bold tracking-tight text-white">
              {String(index + 1).padStart(2, "0")}
            </span>
            <span class="rounded bg-violet-600 px-2 py-1 text-[8px] font-bold uppercase tracking-wider text-white">
              {content.badge}
            </span>
          </div>

          <div class="flex gap-3">
            <a
              href={withBasePath(`/products/${product.slug}`)}
              class="size-18 shrink-0 overflow-hidden rounded-lg bg-white/5"
            >
              <Image
                src={product.image}
                alt={product.name}
                class="h-full w-full object-cover transition duration-500 group-hover:scale-105"
              />
            </a>

            <div class="min-w-0 flex-1">
              <p class="text-[8px] font-semibold uppercase tracking-[0.16em] text-violet-400">
                {product.category}
              </p>
              <a
                href={withBasePath(`/products/${product.slug}`)}
                class="mt-1 line-clamp-2 block min-h-8 text-xs font-semibold leading-4 text-white transition hover:text-violet-300"
              >
                {product.name}
              </a>
              <div class="mt-2 flex items-baseline gap-2">
                <span class="text-xs font-bold text-white">
                  CHF {product.price}
                </span>
                <span class="text-[9px] text-slate-500 line-through">
                  CHF {Math.round(product.price * 1.2)}
                </span>
              </div>
              <span
                class="mt-1 block text-[9px] tracking-wider text-amber-400"
                aria-label="5 out of 5 stars"
              >
                ★★★★★
              </span>
            </div>
          </div>

          <a
            href={withBasePath("/cart")}
            aria-label={`Add ${product.name} to cart`}
            class="absolute bottom-4 right-4 flex size-7 items-center justify-center rounded-md bg-violet-600 text-sm font-bold text-white transition hover:bg-violet-500"
          >
            +
          </a>
        </article>
      ))
    }
  </div>
</section>
