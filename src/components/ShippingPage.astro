---
const deliveryOptions = [
  { number: "01", title: "Standard delivery", time: "2–4 business days", description: "Tracked delivery across Switzerland for everyday orders." },
  { number: "02", title: "Priority delivery", time: "1–2 business days", description: "Faster tracked shipping when your setup cannot wait." },
  { number: "03", title: "Secure packaging", time: "Always included", description: "Protective, right-sized packaging designed for refurbished hardware." },
];
---

<section class="py-10 lg:py-16">
  <div class="rounded-3xl bg-[#08080f] p-8 text-white sm:p-12 lg:p-16">
    <p class="text-xs font-semibold uppercase tracking-[0.22em] text-violet-400">Shipping</p>
    <h1 class="mt-5 max-w-4xl text-5xl font-bold tracking-tight sm:text-6xl">From our lab to your setup, safely.</h1>
    <p class="mt-6 max-w-2xl text-base leading-7 text-slate-300">Clear delivery options, tracked parcels and careful packaging for every refurbished device.</p>
  </div>

  <div class="mt-8 grid gap-4 md:grid-cols-3">
    {deliveryOptions.map((option) => (
      <article class="rounded-2xl border border-slate-200 bg-white p-7">
        <span class="text-xs font-bold text-violet-600">/{option.number}</span>
        <h2 class="mt-10 text-2xl font-bold tracking-tight text-slate-950">{option.title}</h2>
        <p class="mt-2 text-sm font-semibold text-violet-600">{option.time}</p>
        <p class="mt-4 text-sm leading-6 text-slate-500">{option.description}</p>
      </article>
    ))}
  </div>

  <div class="mt-8 grid overflow-hidden rounded-2xl bg-violet-600 text-white lg:grid-cols-3">
    <div class="p-7 lg:col-span-2 lg:p-10">
      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-violet-200">Order journey</p>
      <h2 class="mt-3 text-3xl font-bold">Tested. Packed. Tracked.</h2>
      <p class="mt-4 max-w-2xl leading-7 text-violet-100">Once your order is prepared, you receive tracking details by email. Delivery estimates begin when the parcel leaves our lab.</p>
    </div>
    <div class="flex items-center border-t border-white/15 p-7 lg:border-l lg:border-t-0 lg:p-10">
      <a href="/contact" class="flex w-full items-center justify-between rounded-xl bg-white px-5 py-4 text-sm font-semibold text-violet-700">Ask about delivery <span>→</span></a>
    </div>
  </div>
</section>
