---
import { getEntry } from "astro:content";
import { withBasePath } from "../utils/paths";

const page = await getEntry("pages", "shipping");
if (!page || page.data.template !== "shipping") throw new Error("Shipping content not found");
const content = page.data;
---

<section class="py-10 lg:py-16">
  <div class="rounded-3xl bg-[#08080f] p-8 text-white sm:p-12 lg:p-16">
    <p class="text-xs font-semibold uppercase tracking-[0.22em] text-violet-400">{content.eyebrow}</p>
    <h1 class="mt-5 max-w-4xl text-5xl font-bold tracking-tight sm:text-6xl">{content.title}</h1>
    <p class="mt-6 max-w-2xl text-base leading-7 text-slate-300">{content.description}</p>
  </div>

  <div class="mt-8 grid gap-4 md:grid-cols-3">
    {content.options.map((option) => (
      <article class="rounded-2xl border border-slate-200 bg-white p-7">
        <span class="text-xs font-bold text-violet-600">/{option.number}</span>
        <h2 class="mt-10 text-2xl font-bold tracking-tight text-slate-950">{option.title}</h2>
        <p class="mt-2 text-sm font-semibold text-violet-600">{option.time}</p>
        <p class="mt-4 text-sm leading-6 text-slate-500">{option.description}</p>
      </article>
    ))}
  </div>

  <div class="mt-8 grid overflow-hidden rounded-2xl bg-violet-600 text-white lg:grid-cols-3">
    <div class="p-7 lg:col-span-2 lg:p-10">
      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-violet-200">{content.journeyEyebrow}</p>
      <h2 class="mt-3 text-3xl font-bold">{content.journeyTitle}</h2>
      <p class="mt-4 max-w-2xl leading-7 text-violet-100">{content.journeyDescription}</p>
    </div>
    <div class="flex items-center border-t border-white/15 p-7 lg:border-l lg:border-t-0 lg:p-10">
      <a href={withBasePath(content.action.href)} class="flex w-full items-center justify-between rounded-xl bg-white px-5 py-4 text-sm font-semibold text-violet-700">{content.action.label} <span>→</span></a>
    </div>
  </div>
</section>
