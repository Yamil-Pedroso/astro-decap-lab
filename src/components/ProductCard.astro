---
import { Image } from "astro:assets";
import type { ProductCardProps } from "../types/product";

type Props = ProductCardProps;

const { product } = Astro.props;
---

<a
  href={`/products/${product.slug}`}
  class="group block overflow-hidden border border-slate-200 bg-white transition duration-300 hover:-translate-y-1 hover:border-violet-400"
>
  <div class="relative aspect-[4/3] overflow-hidden bg-slate-100">
    <Image
      src={product.image}
      alt={product.name}
      class="h-full w-full object-cover transition duration-500 group-hover:scale-[1.03]"
    />

    <div
      class="absolute left-4 top-4 bg-slate-950 px-3 py-1 text-[11px] font-semibold uppercase tracking-[0.18em] text-white"
    >
      {product.category}
    </div>
  </div>

  <div class="p-6">
    <div class="flex items-start justify-between gap-6">
      <h2 class="text-xl font-semibold tracking-tight text-slate-950">
        {product.name}
      </h2>

      <span class="text-sm font-semibold text-violet-600"> → </span>
    </div>

    <p class="mt-3 line-clamp-2 text-sm leading-6 text-slate-500">
      {product.description}
    </p>

    <div
      class="mt-8 flex items-end justify-between border-t border-slate-200 pt-5"
    >
      <div>
        <p
          class="text-[10px] font-semibold uppercase tracking-[0.2em] text-slate-400"
        >
          Refurbished
        </p>

        <p class="mt-1 text-2xl font-bold text-slate-950">
          CHF {product.price}
        </p>
      </div>

      <span
        class="text-xs font-medium uppercase tracking-[0.15em] text-slate-400"
      >
        View product
      </span>
    </div>
  </div>
</a>
