---
import { footerNavigation } from "../data/navigation";
import { withBasePath } from "../utils/paths";
---

<footer class="mt-24 bg-[#0a0a0c] text-white">
  <div class="mx-auto w-full max-w-[1600px] px-4 sm:px-6 lg:px-8">
    <!-- Main footer -->
    <div class="grid gap-14 py-16 lg:grid-cols-[1.5fr_1fr] lg:py-20">
      <!-- Brand -->
      <div>
        <p
          class="text-xs font-semibold uppercase tracking-[0.28em] text-violet-400"
        >
          Reuse / Repair / Reboot
        </p>

        <h2
          class="mt-6 max-w-2xl text-4xl font-bold tracking-tight sm:text-5xl lg:text-6xl"
        >
          Good hardware deserves
          <span class="text-violet-500"> another cycle.</span>
        </h2>

        <p class="mt-6 max-w-xl text-base leading-7 text-slate-400">
          Refurbished computers and components selected to extend the useful
          life of technology.
        </p>
      </div>

      <!-- Navigation -->
      <div class="grid grid-cols-2 gap-10 sm:grid-cols-3">
        {footerNavigation.map((group) => (
          <div>
            <p class="mb-5 text-xs font-semibold uppercase tracking-[0.2em] text-slate-500">
              {group.title}
            </p>

            <ul class="space-y-3 text-sm text-slate-300">
              {group.links.map((link) => (
                <li>
                  <a class="transition hover:text-violet-400" href={withBasePath(link.href)}>
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>

    <!-- Technical strip -->
    <div
      class="flex flex-col gap-4 border-t border-white/10 py-6 text-[11px] font-medium uppercase tracking-[0.18em] text-slate-500 sm:flex-row sm:items-center sm:justify-between"
    >
      <p>
        © {new Date().getFullYear()} Reboot Lab
      </p>

      <div class="flex flex-wrap gap-x-6 gap-y-2">
        <span>Refurbished / CH</span>
        <span
          >System status: <strong class="text-violet-400">Online</strong></span
        >
        <span>RL / 001</span>
      </div>
    </div>
  </div>
</footer>
