---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import { getCategoryProductCounts } from "../data/search";
import { withBasePath } from "../utils/paths";

const [productEntries, categoryEntries] = await Promise.all([
  getCollection("products"),
  getCollection("categories"),
]);
const products = productEntries.map((entry) => ({
  slug: entry.id,
  ...entry.data,
}));
const categories = categoryEntries
  .map((entry) => ({ slug: entry.id, ...entry.data }))
  .sort((a, b) => a.order - b.order);
const categoryProductCounts = getCategoryProductCounts(categories, products);
---

<dialog
  id="search-modal"
  aria-labelledby="search-modal-title"
  class="fixed inset-0 m-auto w-[min(94vw,760px)] max-w-none border-0 bg-transparent p-0 backdrop:bg-transparent"
>
  <div class="search-panel max-h-[min(88dvh,780px)] overflow-hidden rounded-2xl bg-white shadow-2xl">
    <header class="border-b border-slate-200 p-5 sm:p-6">
      <div class="flex items-start justify-between gap-4">
        <div>
          <p class="text-[10px] font-semibold uppercase tracking-[0.2em] text-violet-600">Reboot Lab search</p>
          <h2 id="search-modal-title" class="mt-1 text-2xl font-bold tracking-tight text-slate-950">Find your next device</h2>
        </div>
        <button type="button" data-search-close aria-label="Close search" class="flex size-10 shrink-0 items-center justify-center rounded-full border border-slate-200 text-xl text-slate-500 transition hover:border-violet-300 hover:bg-violet-50 hover:text-violet-600">×</button>
      </div>

      <label class="relative mt-5 block">
        <span class="sr-only">Search products and categories</span>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true" class="pointer-events-none absolute left-4 top-1/2 size-5 -translate-y-1/2 text-slate-400">
          <circle cx="11" cy="11" r="7"></circle>
          <path d="m20 20-4-4"></path>
        </svg>
        <input
          data-search-input
          type="search"
          autocomplete="off"
          placeholder="Search ThinkPad, monitors, components..."
          class="w-full rounded-xl border border-slate-200 bg-slate-50 py-4 pl-12 pr-4 text-base outline-none transition placeholder:text-slate-400 focus:border-violet-500 focus:bg-white focus:ring-3 focus:ring-violet-100"
        />
      </label>

      <div class="mt-3 flex items-center justify-between gap-4 text-[11px] text-slate-400">
        <p data-search-count>{products.length + categories.length} results available</p>
        <span class="hidden rounded-md border border-slate-200 px-2 py-1 font-medium sm:inline">ESC to close</span>
      </div>
    </header>

    <div class="max-h-[calc(min(88dvh,780px)-210px)] overflow-y-auto p-4 sm:p-5">
      <div data-search-results class="space-y-2">
        {
          products.map((product) => (
            <a
              href={withBasePath(`/products/${product.slug}`)}
              data-search-item
              data-search-value={`${product.name} ${product.category} ${product.description} ${product.price} CHF available refurbished`}
              class="group grid grid-cols-[72px_1fr_auto] items-center gap-4 rounded-xl border border-transparent p-2 transition hover:border-violet-200 hover:bg-violet-50"
            >
              <div class="size-18 overflow-hidden rounded-lg bg-slate-100">
                <Image src={product.image} alt="" class="size-full object-cover" />
              </div>
              <div class="min-w-0">
                <p class="text-[9px] font-semibold uppercase tracking-[0.16em] text-violet-600">Product / {product.category}</p>
                <h3 class="mt-1 truncate text-sm font-bold text-slate-950 group-hover:text-violet-700">{product.name}</h3>
                <p class="mt-1 line-clamp-1 text-xs text-slate-500">{product.description}</p>
              </div>
              <div class="text-right">
                <p class="text-sm font-bold text-slate-950">CHF {product.price}</p>
                <span class="mt-2 inline-block text-sm text-violet-600">→</span>
              </div>
            </a>
          ))
        }

        {
          categories.map((category) => (
            <a
              href={withBasePath(`/categories/${category.slug}`)}
              data-search-item
              data-search-value={`${category.name} ${category.slug} ${category.description} category`}
              class="group flex items-center justify-between gap-5 rounded-xl border border-slate-200 p-4 transition hover:border-violet-300 hover:bg-violet-50"
            >
              <div>
                <p class="text-[9px] font-semibold uppercase tracking-[0.16em] text-slate-400">Category</p>
                <h3 class="mt-1 text-sm font-bold text-slate-950 group-hover:text-violet-700">{category.name}</h3>
                <p class="mt-1 text-xs text-slate-500">{categoryProductCounts[category.slug]} {categoryProductCounts[category.slug] === 1 ? "item" : "items"}</p>
              </div>
              <span class="flex size-9 items-center justify-center rounded-full bg-slate-950 text-sm text-white transition group-hover:bg-violet-600">→</span>
            </a>
          ))
        }
      </div>

      <div data-search-empty class="hidden py-16 text-center">
        <span class="mx-auto flex size-16 items-center justify-center rounded-full bg-violet-50 text-2xl text-violet-600">?</span>
        <h3 class="mt-5 text-xl font-bold text-slate-950">No products found</h3>
        <p class="mt-2 text-sm text-slate-500">Try another product name, category or price.</p>
      </div>
    </div>
  </div>
</dialog>

<script>
  const searchModal = document.querySelector<HTMLDialogElement>("#search-modal");
  const searchInput = searchModal?.querySelector<HTMLInputElement>("[data-search-input]");
  const searchItems = searchModal?.querySelectorAll<HTMLElement>("[data-search-item]") ?? [];
  const searchEmpty = searchModal?.querySelector<HTMLElement>("[data-search-empty]");
  const searchCount = searchModal?.querySelector<HTMLElement>("[data-search-count]");
  const searchReduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
  let searchCloseTimer: number | undefined;

  function normalizeSearch(value: string) {
    return value.normalize("NFD").replace(/[\u0300-\u036f]/g, "").toLowerCase().trim();
  }

  function filterSearchResults() {
    const query = normalizeSearch(searchInput?.value ?? "");
    let visibleCount = 0;

    searchItems.forEach((item) => {
      const isVisible = normalizeSearch(item.dataset.searchValue ?? "").includes(query);
      item.classList.toggle("hidden", !isVisible);
      if (isVisible) visibleCount += 1;
    });

    searchEmpty?.classList.toggle("hidden", visibleCount !== 0);
    if (searchCount) searchCount.textContent = `${visibleCount} ${visibleCount === 1 ? "result" : "results"}`;
  }

  function openSearch() {
    if (!searchModal) return;
    if (searchCloseTimer) window.clearTimeout(searchCloseTimer);

    searchInput?.value && (searchInput.value = "");
    filterSearchResults();

    if (!searchModal.open) searchModal.showModal();
    window.requestAnimationFrame(() => {
      window.requestAnimationFrame(() => {
        searchModal.classList.add("is-visible");
        searchInput?.focus();
      });
    });
  }

  function closeSearch() {
    if (!searchModal?.open) return;
    searchModal.classList.remove("is-visible");

    if (searchReduceMotion.matches) {
      searchModal.close();
      return;
    }

    searchCloseTimer = window.setTimeout(() => {
      searchModal.close();
      searchCloseTimer = undefined;
    }, 240);
  }

  document.querySelectorAll<HTMLElement>("[data-search-open]").forEach((button) => button.addEventListener("click", openSearch));
  searchModal?.querySelectorAll<HTMLElement>("[data-search-close]").forEach((button) => button.addEventListener("click", closeSearch));
  searchInput?.addEventListener("input", filterSearchResults);
  searchModal?.addEventListener("click", (event) => {
    if (event.target === searchModal) closeSearch();
  });
  searchModal?.addEventListener("cancel", (event) => {
    event.preventDefault();
    closeSearch();
  });
</script>

<style>
  #search-modal .search-panel {
    opacity: 0;
    transform: translateY(-18px) scale(0.98);
    transition: opacity 240ms ease, transform 240ms ease;
  }

  #search-modal::backdrop {
    background-color: rgb(15 23 42 / 0%);
    backdrop-filter: blur(0);
    transition: background-color 240ms ease, backdrop-filter 240ms ease;
  }

  #search-modal.is-visible .search-panel {
    opacity: 1;
    transform: translateY(0) scale(1);
  }

  #search-modal.is-visible::backdrop {
    background-color: rgb(15 23 42 / 70%);
    backdrop-filter: blur(4px);
  }

  @media (prefers-reduced-motion: reduce) {
    #search-modal .search-panel,
    #search-modal::backdrop {
      transition: none;
    }
  }
</style>
