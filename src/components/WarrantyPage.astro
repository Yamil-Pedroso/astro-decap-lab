---
const steps = [
  { title: "Tell us what happened", description: "Send the order number and a clear description of the issue." },
  { title: "We diagnose the product", description: "Our team reviews the symptoms and proposes the next step." },
  { title: "Repair, replace or refund", description: "We choose the most sensible resolution under the warranty terms." },
];
---

<section class="py-10 lg:py-16">
  <div class="grid overflow-hidden rounded-3xl bg-[#08080f] text-white lg:grid-cols-[1.2fr_0.8fr]">
    <div class="p-8 sm:p-12 lg:p-16">
      <p class="text-xs font-semibold uppercase tracking-[0.22em] text-violet-400">Warranty</p>
      <h1 class="mt-5 max-w-3xl text-5xl font-bold tracking-tight sm:text-6xl">Refurbished should still feel dependable.</h1>
      <p class="mt-6 max-w-2xl text-base leading-7 text-slate-300">Every Reboot Lab product includes clear coverage and practical support when something does not perform as expected.</p>
    </div>
    <div class="flex flex-col justify-end border-t border-white/10 bg-violet-600 p-8 lg:border-l lg:border-t-0 lg:p-12">
      <strong class="text-7xl font-bold">12</strong>
      <span class="mt-2 text-sm font-semibold uppercase tracking-[0.18em] text-violet-200">Months standard coverage</span>
    </div>
  </div>

  <div class="mt-10 grid gap-8 lg:grid-cols-[0.75fr_1.25fr]">
    <div>
      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-violet-600">Claim process</p>
      <h2 class="mt-3 text-4xl font-bold tracking-tight text-slate-950">Straightforward support in three steps.</h2>
      <a href="/contact" class="mt-7 inline-flex rounded-xl bg-violet-600 px-5 py-3 text-sm font-semibold text-white">Start a claim →</a>
    </div>
    <div class="space-y-3">
      {steps.map((step, index) => (
        <article class="grid gap-4 rounded-2xl border border-slate-200 bg-white p-6 sm:grid-cols-[60px_1fr]">
          <span class="text-3xl font-bold text-violet-600">{String(index + 1).padStart(2, "0")}</span>
          <div><h3 class="text-xl font-bold text-slate-950">{step.title}</h3><p class="mt-2 text-sm leading-6 text-slate-500">{step.description}</p></div>
        </article>
      ))}
    </div>
  </div>

  <div class="mt-10 rounded-2xl border border-slate-200 bg-slate-100 p-7 sm:p-9">
    <h2 class="text-xl font-bold text-slate-950">Coverage notes</h2>
    <p class="mt-3 max-w-4xl text-sm leading-7 text-slate-600">Coverage applies to hardware faults under normal use. Accidental damage, liquid damage, unauthorized modifications and ordinary cosmetic wear are not included. Final terms should be reviewed before this demo store processes real orders.</p>
  </div>
</section>
