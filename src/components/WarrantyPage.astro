---
import { getEntry } from "astro:content";
import { withBasePath } from "../utils/paths";

const page = await getEntry("pages", "warranty");
if (!page || page.data.template !== "warranty") throw new Error("Warranty content not found");
const content = page.data;
---

<section class="py-10 lg:py-16">
  <div class="grid overflow-hidden rounded-3xl bg-[#08080f] text-white lg:grid-cols-[1.2fr_0.8fr]">
    <div class="p-8 sm:p-12 lg:p-16">
      <p class="text-xs font-semibold uppercase tracking-[0.22em] text-violet-400">{content.eyebrow}</p>
      <h1 class="mt-5 max-w-3xl text-5xl font-bold tracking-tight sm:text-6xl">{content.title}</h1>
      <p class="mt-6 max-w-2xl text-base leading-7 text-slate-300">{content.description}</p>
    </div>
    <div class="flex flex-col justify-end border-t border-white/10 bg-violet-600 p-8 lg:border-l lg:border-t-0 lg:p-12">
      <strong class="text-7xl font-bold">{content.coverageMonths}</strong>
      <span class="mt-2 text-sm font-semibold uppercase tracking-[0.18em] text-violet-200">{content.coverageLabel}</span>
    </div>
  </div>

  <div class="mt-10 grid gap-8 lg:grid-cols-[0.75fr_1.25fr]">
    <div>
      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-violet-600">{content.processEyebrow}</p>
      <h2 class="mt-3 text-4xl font-bold tracking-tight text-slate-950">{content.processTitle}</h2>
      <a href={withBasePath(content.processAction.href)} class="mt-7 inline-flex rounded-xl bg-violet-600 px-5 py-3 text-sm font-semibold text-white">{content.processAction.label} →</a>
    </div>
    <div class="space-y-3">
      {content.steps.map((step, index) => (
        <article class="grid gap-4 rounded-2xl border border-slate-200 bg-white p-6 sm:grid-cols-[60px_1fr]">
          <span class="text-3xl font-bold text-violet-600">{String(index + 1).padStart(2, "0")}</span>
          <div><h3 class="text-xl font-bold text-slate-950">{step.title}</h3><p class="mt-2 text-sm leading-6 text-slate-500">{step.description}</p></div>
        </article>
      ))}
    </div>
  </div>

  <div class="mt-10 rounded-2xl border border-slate-200 bg-slate-100 p-7 sm:p-9">
    <h2 class="text-xl font-bold text-slate-950">{content.notesTitle}</h2>
    <p class="mt-3 max-w-4xl text-sm leading-7 text-slate-600">{content.notes}</p>
  </div>
</section>
