---
import { Image } from "astro:assets";
import { categoryPromos } from "../data/category-promos";

const [laptopPromo, desktopPromo, monitorPromo, componentPromo] = categoryPromos;
---

<section class="mt-3" aria-labelledby="category-promos-title">
  <h2 id="category-promos-title" class="sr-only">Featured categories</h2>

  <div
    class="grid gap-4 md:grid-cols-2 lg:grid-cols-[1.05fr_0.8fr_1.35fr]"
  >
    <a
      href={`/categories/${laptopPromo.slug}`}
      class="group relative min-h-80 overflow-hidden rounded-2xl bg-[#08080b] p-7 text-white"
    >
      <Image
        src={laptopPromo.image}
        alt=""
        class="absolute inset-0 h-full w-full object-cover object-center transition duration-500 group-hover:scale-[1.03]"
      />
      <div
        class="absolute inset-0 bg-linear-to-r from-black via-black/65 to-transparent"
      >
      </div>

      <div class="relative z-10 flex h-full max-w-52 flex-col items-start">
        <p
          class="text-[10px] font-semibold uppercase tracking-[0.2em] text-violet-300"
        >
          {laptopPromo.eyebrow}
        </p>
        <h3 class="mt-4 text-3xl font-bold tracking-tight">{laptopPromo.title}</h3>
        <p class="mt-2 text-sm leading-6 text-slate-300">
          {laptopPromo.description}
        </p>
        <p class="mt-5 text-xs font-medium text-slate-400">{laptopPromo.price}</p>
        <span
          class="mt-5 rounded-lg bg-white px-4 py-2 text-xs font-semibold text-slate-950 transition group-hover:bg-violet-500 group-hover:text-white"
        >
          {laptopPromo.cta}
        </span>
      </div>
    </a>

    <a
      href={`/categories/${desktopPromo.slug}`}
      class="group relative min-h-80 overflow-hidden rounded-2xl bg-violet-700 p-7 text-white"
    >
      <Image
        src={desktopPromo.image}
        alt=""
        class="absolute inset-0 h-full w-full object-cover opacity-85 mix-blend-multiply transition duration-500 group-hover:scale-[1.03]"
      />
      <div class="absolute inset-0 bg-linear-to-b from-violet-950/20 to-black/40">
      </div>

      <div class="relative z-10 flex h-full max-w-48 flex-col items-start">
        <p
          class="text-[10px] font-semibold uppercase tracking-[0.2em] text-violet-100"
        >
          {desktopPromo.eyebrow}
        </p>
        <h3 class="mt-4 text-3xl font-bold tracking-tight">
          {desktopPromo.title}
        </h3>
        <p class="mt-2 text-sm leading-6 text-violet-100">
          {desktopPromo.description}
        </p>
        <span
          class="mt-5 rounded-lg bg-white px-4 py-2 text-xs font-semibold text-violet-800 transition group-hover:bg-violet-950 group-hover:text-white"
        >
          {desktopPromo.cta}
        </span>
      </div>
    </a>

    <div class="grid gap-4 md:col-span-2 lg:col-span-1">
      <a
        href={`/categories/${monitorPromo.slug}`}
        class="group relative min-h-38 overflow-hidden rounded-2xl bg-[#dceaff] p-6 text-slate-950"
      >
        <Image
          src={monitorPromo.image}
          alt=""
          class="absolute inset-y-0 right-0 h-full w-3/5 object-cover object-center mix-blend-multiply transition duration-500 group-hover:scale-[1.04]"
        />
        <div
          class="absolute inset-0 bg-linear-to-r from-[#dceaff] via-[#dceaff]/90 to-transparent"
        >
        </div>

        <div class="relative z-10 max-w-48">
          <h3 class="text-2xl font-bold leading-tight tracking-tight">
            {monitorPromo.title}
          </h3>
          <p class="mt-2 text-xs leading-5 text-slate-600">
            {monitorPromo.description}
          </p>
          <span
            class="mt-4 inline-flex rounded-lg bg-white px-3 py-2 text-xs font-semibold shadow-sm transition group-hover:bg-violet-600 group-hover:text-white"
          >
            {monitorPromo.cta}
          </span>
        </div>
      </a>

      <a
        href={`/categories/${componentPromo.slug}`}
        class="group relative min-h-38 overflow-hidden rounded-2xl bg-[#e8f2b8] p-6 text-slate-950"
      >
        <Image
          src={componentPromo.image}
          alt=""
          class="absolute inset-y-0 right-0 h-full w-3/5 object-cover object-center mix-blend-multiply transition duration-500 group-hover:scale-[1.04]"
        />
        <div
          class="absolute inset-0 bg-linear-to-r from-[#e8f2b8] via-[#e8f2b8]/90 to-transparent"
        >
        </div>

        <div class="relative z-10 max-w-48">
          <h3 class="text-2xl font-bold leading-tight tracking-tight">
            {componentPromo.title}
          </h3>
          <p class="mt-2 text-xs leading-5 text-slate-600">
            {componentPromo.description}
          </p>
          <span
            class="mt-4 inline-flex rounded-lg bg-white px-3 py-2 text-xs font-semibold shadow-sm transition group-hover:bg-violet-600 group-hover:text-white"
          >
            {componentPromo.cta}
          </span>
        </div>
      </a>
    </div>
  </div>
</section>
