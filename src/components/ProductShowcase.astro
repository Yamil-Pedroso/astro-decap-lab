---
import { Image } from "astro:assets";
import { categories } from "../data/categories";
import { products } from "../data/products";

const collectionTones = [
  "bg-violet-50",
  "bg-slate-100",
  "bg-blue-50",
  "bg-lime-50",
];

const collections = categories.map((category, index) => ({
  ...category,
  image: products.find((product) => product.category === category.slug)?.image,
  tone: collectionTones[index],
}));

const discounts = [20, 15, 30, 20, 10, 15];
const flashDeals = Array.from({ length: 6 }, (_, index) => ({
  product: products[index % products.length],
  discount: discounts[index],
}));

const newArrivals = Array.from(
  { length: 4 },
  (_, index) => products[(index + 1) % products.length],
);

const featuredProduct = products[0];
---

<section class="mt-16 space-y-12" aria-label="Product highlights">
  <div>
    <div class="mb-5 flex items-end justify-between gap-4">
      <div>
        <p
          class="text-[10px] font-semibold uppercase tracking-[0.2em] text-violet-600"
        >
          Browse the lab
        </p>
        <h2 class="mt-2 text-2xl font-bold tracking-tight text-slate-950">
          Featured collections
        </h2>
      </div>
      <a
        href="/categories"
        class="text-xs font-semibold text-slate-500 transition hover:text-violet-600"
      >
        View all →
      </a>
    </div>

    <div class="grid gap-3 sm:grid-cols-2 xl:grid-cols-4">
      {
        collections.map((collection) => (
          <a
            href={`/categories/${collection.slug}`}
            class:list={[
              "group relative min-h-26 overflow-hidden rounded-xl p-4",
              collection.tone,
            ]}
          >
            {collection.image && (
              <Image
                src={collection.image}
                alt=""
                class="absolute inset-y-0 right-0 h-full w-1/2 object-cover object-center mix-blend-multiply transition duration-500 group-hover:scale-105"
              />
            )}
            <div class="relative z-10 max-w-[45%]">
              <h3 class="text-sm font-bold text-slate-950">
                {collection.name}
              </h3>
              <p class="mt-1.5 line-clamp-2 text-[11px] leading-4 text-slate-500">
                {collection.description}
              </p>
              <span class="mt-2 inline-flex text-[11px] font-semibold text-violet-600">
                Explore now →
              </span>
            </div>
          </a>
        ))
      }
    </div>
  </div>

  <div>
    <div class="mb-5 flex flex-wrap items-end justify-between gap-4">
      <div class="flex flex-wrap items-end gap-6">
        <div>
          <p
            class="text-[10px] font-semibold uppercase tracking-[0.2em] text-violet-600"
          >
            Limited offers
          </p>
          <h2 class="mt-2 text-2xl font-bold tracking-tight text-slate-950">
            Flash deals
          </h2>
        </div>

        <div class="flex items-center gap-2" aria-label="Offer countdown">
          <div class="text-center">
            <span class="block text-sm font-bold text-slate-950">07</span>
            <span class="text-[8px] uppercase tracking-wider text-slate-400">
              Days
            </span>
          </div>
          <span class="pb-3 text-slate-300">:</span>
          <div class="text-center">
            <span class="block text-sm font-bold text-slate-950">45</span>
            <span class="text-[8px] uppercase tracking-wider text-slate-400">
              Hours
            </span>
          </div>
          <span class="pb-3 text-slate-300">:</span>
          <div class="text-center">
            <span class="block text-sm font-bold text-slate-950">32</span>
            <span class="text-[8px] uppercase tracking-wider text-slate-400">
              Mins
            </span>
          </div>
        </div>
      </div>

      <a
        href="/products"
        class="text-xs font-semibold text-slate-500 transition hover:text-violet-600"
      >
        View all deals →
      </a>
    </div>

    <div class="grid grid-cols-2 gap-3 md:grid-cols-3 xl:grid-cols-6">
      {
        flashDeals.map(({ product, discount }) => (
          <article class="group overflow-hidden rounded-xl border border-slate-200 bg-white transition duration-300 hover:-translate-y-1 hover:border-violet-300 hover:shadow-lg hover:shadow-violet-100">
            <a
              href={`/products/${product.slug}`}
              class="relative block h-36 overflow-hidden bg-slate-50 xl:h-32"
            >
              <Image
                src={product.image}
                alt={product.name}
                class="h-full w-full object-cover transition duration-500 group-hover:scale-105"
              />
              <span class="absolute left-3 top-3 rounded-md bg-red-500 px-2 py-1 text-[9px] font-bold text-white">
                -{discount}%
              </span>
            </a>

            <div class="p-3">
              <p class="text-[9px] font-semibold uppercase tracking-[0.16em] text-violet-600">
                {product.category}
              </p>
              <a
                href={`/products/${product.slug}`}
                class="mt-1.5 block min-h-9 text-xs font-semibold leading-4 text-slate-950 transition hover:text-violet-600"
              >
                {product.name}
              </a>
              <div class="mt-2 flex flex-wrap items-baseline gap-2">
                <span class="text-sm font-bold text-slate-950">
                  CHF {product.price}
                </span>
                <span class="text-[10px] text-slate-400 line-through">
                  CHF {Math.round(product.price / (1 - discount / 100))}
                </span>
              </div>
              <div class="mt-2 flex items-center justify-between gap-2">
                <span
                  class="text-[10px] tracking-wider text-amber-400"
                  aria-label="5 out of 5 stars"
                >
                  ★★★★★
                </span>
                <a
                  href="/cart"
                  aria-label={`Add ${product.name} to cart`}
                  class="flex size-7 items-center justify-center rounded-md bg-violet-600 text-sm font-bold text-white transition hover:bg-violet-700"
                >
                  +
                </a>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>

  <div>
    <div class="mb-5 flex items-end justify-between gap-4">
      <div>
        <p
          class="text-[10px] font-semibold uppercase tracking-[0.2em] text-violet-600"
        >
          Freshly tested
        </p>
        <h2 class="mt-2 text-2xl font-bold tracking-tight text-slate-950">
          New arrivals
        </h2>
      </div>
      <a
        href="/products"
        class="text-xs font-semibold text-slate-500 transition hover:text-violet-600"
      >
        View all →
      </a>
    </div>

    <div class="grid grid-cols-2 gap-3 md:grid-cols-3 xl:grid-cols-6">
      <a
        href={`/products/${featuredProduct.slug}`}
        class="group relative col-span-2 min-h-72 overflow-hidden rounded-xl bg-[#13072c] p-6 text-white md:col-span-3 xl:col-span-2"
      >
        <Image
          src={featuredProduct.image}
          alt=""
          class="absolute inset-0 h-full w-full object-cover transition duration-500 group-hover:scale-[1.03]"
        />
        <div
          class="absolute inset-0 bg-linear-to-r from-violet-950 via-violet-950/75 to-transparent"
        >
        </div>

        <div class="relative z-10 max-w-52">
          <span
            class="rounded-md bg-violet-600 px-2 py-1 text-[9px] font-bold uppercase tracking-wider"
          >
            Just arrived
          </span>
          <h3 class="mt-4 text-2xl font-bold tracking-tight">
            {featuredProduct.name}
          </h3>
          <p class="mt-2 text-xs leading-5 text-violet-100">
            Adapted, tested and ready for another productive cycle.
          </p>
          <p class="mt-4 text-base font-bold">CHF {featuredProduct.price}</p>
          <span
            class="mt-5 inline-flex rounded-lg bg-white px-4 py-2 text-xs font-semibold text-violet-900 transition group-hover:bg-violet-500 group-hover:text-white"
          >
            Explore now →
          </span>
        </div>
      </a>

      {
        newArrivals.map((product) => (
          <article class="group overflow-hidden rounded-xl border border-slate-200 bg-white transition duration-300 hover:-translate-y-1 hover:border-violet-300">
            <a
              href={`/products/${product.slug}`}
              class="relative block h-36 overflow-hidden bg-slate-50 xl:h-32"
            >
              <Image
                src={product.image}
                alt={product.name}
                class="h-full w-full object-cover transition duration-500 group-hover:scale-105"
              />
              <span class="absolute left-3 top-3 rounded-md bg-violet-600 px-2 py-1 text-[9px] font-bold uppercase text-white">
                New
              </span>
            </a>
            <div class="p-3">
              <a
                href={`/products/${product.slug}`}
                class="block min-h-9 text-xs font-semibold leading-4 text-slate-950 transition hover:text-violet-600"
              >
                {product.name}
              </a>
              <p class="mt-2 text-sm font-bold text-slate-950">
                CHF {product.price}
              </p>
              <div class="mt-2 flex items-center justify-between gap-2">
                <span
                  class="text-[10px] tracking-wider text-amber-400"
                  aria-label="5 out of 5 stars"
                >
                  ★★★★★
                </span>
                <a
                  href="/cart"
                  aria-label={`Add ${product.name} to cart`}
                  class="flex size-7 items-center justify-center rounded-md bg-violet-600 text-sm font-bold text-white transition hover:bg-violet-700"
                >
                  +
                </a>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
