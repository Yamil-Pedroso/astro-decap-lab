---
import { getImage, Image } from "astro:assets";
import { getCollection, getEntry } from "astro:content";
import { collectionTones } from "../data/product-showcase";
import type { FlashDeal, Product, ProductCollection } from "../types/product";

interface Props {
  products: Product[];
}

const { products } = Astro.props;
const [categoryEntries, page] = await Promise.all([
  getCollection("categories"),
  getEntry("pages", "home"),
]);
if (!page || page.data.template !== "home") throw new Error("Home content not found");
const categories = categoryEntries
  .map((entry) => ({ slug: entry.id, ...entry.data }))
  .sort((a, b) => a.order - b.order);
const content = page.data.showcase;
const productsBySlug = new Map(products.map((product) => [product.slug, product]));

const productCollections: ProductCollection[] = categories.map((category) => ({
  ...category,
  image: products.find((product) => product.category === category.slug)?.image,
  tone: collectionTones[category.slug] ?? "bg-slate-100",
}));

const flashDeals: FlashDeal[] = content.flashDeals.flatMap((config) => {
  const product = productsBySlug.get(config.product);
  return product ? [{ product, discount: config.discount }] : [];
});

const newArrivals = content.newArrivals.flatMap((slug) => {
  const product = productsBySlug.get(slug);
  return product ? [product] : [];
});

const featuredProduct = productsBySlug.get(content.featuredProduct);

if (!featuredProduct) {
  throw new Error(`Featured product not found: ${content.featuredProduct}`);
}

const cartImageEntries = await Promise.all(
  products.map(async (product) => {
    const image = await getImage({
      src: product.image,
      width: 320,
      height: 240,
      fit: "cover",
      format: "webp",
    });

    return [product.slug, image.src] as const;
  }),
);

const cartImages = Object.fromEntries(cartImageEntries);
---

<section id="products" class="mt-16 scroll-mt-6 space-y-12" aria-label={content.ariaLabel}>
  <div>
    <div class="mb-5 flex items-end justify-between gap-4">
      <div>
        <p
          class="text-[10px] font-semibold uppercase tracking-[0.2em] text-violet-600"
        >
          {content.collectionsEyebrow}
        </p>
        <h2 class="mt-2 text-2xl font-bold tracking-tight text-slate-950">
          {content.collectionsTitle}
        </h2>
      </div>
      <a
        href="/categories"
        class="text-xs font-semibold text-slate-500 transition hover:text-violet-600"
      >
        {content.collectionsViewAll}
      </a>
    </div>

    <div class="grid gap-3 sm:grid-cols-2 xl:grid-cols-4">
      {
        productCollections.map((collection) => (
          <a
            href={`/categories/${collection.slug}`}
            class:list={[
              "group relative min-h-26 overflow-hidden rounded-xl p-4",
              collection.tone,
            ]}
          >
            {collection.image && (
              <Image
                src={collection.image}
                alt=""
                class="absolute inset-y-0 right-0 h-full w-1/2 object-cover object-center mix-blend-multiply transition duration-500 group-hover:scale-105"
              />
            )}
            <div class="relative z-10 max-w-[45%]">
              <h3 class="text-sm font-bold text-slate-950">
                {collection.name}
              </h3>
              <p class="mt-1.5 line-clamp-2 text-[11px] leading-4 text-slate-500">
                {collection.description}
              </p>
              <span class="mt-2 inline-flex text-[11px] font-semibold text-violet-600">
                {content.collectionCta}
              </span>
            </div>
          </a>
        ))
      }
    </div>
  </div>

  <div>
    <div class="mb-5 flex flex-wrap items-end justify-between gap-4">
      <div class="flex flex-wrap items-end gap-6">
        <div>
          <p
            class="text-[10px] font-semibold uppercase tracking-[0.2em] text-violet-600"
          >
            {content.dealsEyebrow}
          </p>
          <h2 class="mt-2 text-2xl font-bold tracking-tight text-slate-950">
            {content.dealsTitle}
          </h2>
        </div>

        <div class="flex items-center gap-2" aria-label="Offer countdown">
          <div class="text-center">
            <span class="block text-sm font-bold text-slate-950">{content.countdown.days}</span>
            <span class="text-[8px] uppercase tracking-wider text-slate-400">
              Days
            </span>
          </div>
          <span class="pb-3 text-slate-300">:</span>
          <div class="text-center">
            <span class="block text-sm font-bold text-slate-950">{content.countdown.hours}</span>
            <span class="text-[8px] uppercase tracking-wider text-slate-400">
              Hours
            </span>
          </div>
          <span class="pb-3 text-slate-300">:</span>
          <div class="text-center">
            <span class="block text-sm font-bold text-slate-950">{content.countdown.minutes}</span>
            <span class="text-[8px] uppercase tracking-wider text-slate-400">
              Mins
            </span>
          </div>
        </div>
      </div>

      <a
        href="/products"
        class="text-xs font-semibold text-slate-500 transition hover:text-violet-600"
      >
        {content.dealsViewAll}
      </a>
    </div>

    <div class="grid grid-cols-2 gap-3 md:grid-cols-3 xl:grid-cols-6">
      {
        flashDeals.map(({ product, discount }) => (
          <article class="group overflow-hidden rounded-xl border border-slate-200 bg-white transition duration-300 hover:-translate-y-1 hover:border-violet-300 hover:shadow-lg hover:shadow-violet-100">
            <a
              href={`/products/${product.slug}`}
              class="relative block h-36 overflow-hidden bg-slate-50 xl:h-32"
            >
              <Image
                src={product.image}
                alt={product.name}
                class="h-full w-full object-cover transition duration-500 group-hover:scale-105"
              />
              <span class="absolute left-3 top-3 rounded-md bg-red-500 px-2 py-1 text-[9px] font-bold text-white">
                -{discount}%
              </span>
            </a>

            <div class="p-3">
              <p class="text-[9px] font-semibold uppercase tracking-[0.16em] text-violet-600">
                {product.category}
              </p>
              <a
                href={`/products/${product.slug}`}
                class="mt-1.5 block min-h-9 text-xs font-semibold leading-4 text-slate-950 transition hover:text-violet-600"
              >
                {product.name}
              </a>
              <div class="mt-2 flex flex-wrap items-baseline gap-2">
                <span class="text-sm font-bold text-slate-950">
                  CHF {product.price}
                </span>
                <span class="text-[10px] text-slate-400 line-through">
                  CHF {Math.round(product.price / (1 - discount / 100))}
                </span>
              </div>
              <div class="mt-2 flex items-center justify-between gap-2">
                <span
                  class="text-[10px] tracking-wider text-amber-400"
                  aria-label="5 out of 5 stars"
                >
                  ★★★★★
                </span>
                <button
                  type="button"
                  data-cart-product
                  data-product-slug={product.slug}
                  data-product-name={product.name}
                  data-product-price={product.price}
                  data-product-image={cartImages[product.slug]}
                  aria-label={`Add ${product.name} to cart`}
                  class="flex size-7 items-center justify-center rounded-md bg-violet-600 text-sm font-bold text-white transition hover:bg-violet-700"
                >
                  +
                </button>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>

  <div>
    <div class="mb-5 flex items-end justify-between gap-4">
      <div>
        <p
          class="text-[10px] font-semibold uppercase tracking-[0.2em] text-violet-600"
        >
          {content.arrivalsEyebrow}
        </p>
        <h2 class="mt-2 text-2xl font-bold tracking-tight text-slate-950">
          {content.arrivalsTitle}
        </h2>
      </div>
      <a
        href="/products"
        class="text-xs font-semibold text-slate-500 transition hover:text-violet-600"
      >
        {content.arrivalsViewAll}
      </a>
    </div>

    <div class="grid grid-cols-2 gap-3 md:grid-cols-3 xl:grid-cols-6">
      <a
        href={`/products/${featuredProduct.slug}`}
        class="group relative col-span-2 min-h-72 overflow-hidden rounded-xl bg-[#13072c] p-6 text-white md:col-span-3 xl:col-span-2"
      >
        <Image
          src={featuredProduct.image}
          alt=""
          class="absolute inset-0 h-full w-full object-cover transition duration-500 group-hover:scale-[1.03]"
        />
        <div
          class="absolute inset-0 bg-linear-to-r from-violet-950 via-violet-950/75 to-transparent"
        >
        </div>

        <div class="relative z-10 max-w-52">
          <span
            class="rounded-md bg-violet-600 px-2 py-1 text-[9px] font-bold uppercase tracking-wider"
          >
            {content.featuredBadge}
          </span>
          <h3 class="mt-4 text-2xl font-bold tracking-tight">
            {featuredProduct.name}
          </h3>
          <p class="mt-2 text-xs leading-5 text-violet-100">
            {content.featuredDescription}
          </p>
          <p class="mt-4 text-base font-bold">CHF {featuredProduct.price}</p>
          <span
            class="mt-5 inline-flex rounded-lg bg-white px-4 py-2 text-xs font-semibold text-violet-900 transition group-hover:bg-violet-500 group-hover:text-white"
          >
            {content.featuredCta}
          </span>
        </div>
      </a>

      {
        newArrivals.map((product) => (
          <article class="group overflow-hidden rounded-xl border border-slate-200 bg-white transition duration-300 hover:-translate-y-1 hover:border-violet-300">
            <a
              href={`/products/${product.slug}`}
              class="relative block h-36 overflow-hidden bg-slate-50 xl:h-32"
            >
              <Image
                src={product.image}
                alt={product.name}
                class="h-full w-full object-cover transition duration-500 group-hover:scale-105"
              />
              <span class="absolute left-3 top-3 rounded-md bg-violet-600 px-2 py-1 text-[9px] font-bold uppercase text-white">
                {content.newBadge}
              </span>
            </a>
            <div class="p-3">
              <a
                href={`/products/${product.slug}`}
                class="block min-h-9 text-xs font-semibold leading-4 text-slate-950 transition hover:text-violet-600"
              >
                {product.name}
              </a>
              <p class="mt-2 text-sm font-bold text-slate-950">
                CHF {product.price}
              </p>
              <div class="mt-2 flex items-center justify-between gap-2">
                <span
                  class="text-[10px] tracking-wider text-amber-400"
                  aria-label="5 out of 5 stars"
                >
                  ★★★★★
                </span>
                <button
                  type="button"
                  data-cart-product
                  data-product-slug={product.slug}
                  data-product-name={product.name}
                  data-product-price={product.price}
                  data-product-image={cartImages[product.slug]}
                  aria-label={`Add ${product.name} to cart`}
                  class="flex size-7 items-center justify-center rounded-md bg-violet-600 text-sm font-bold text-white transition hover:bg-violet-700"
                >
                  +
                </button>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLButtonElement>("[data-cart-product]").forEach((button) => {
    button.addEventListener("click", () => {
      const { productSlug, productName, productPrice, productImage } = button.dataset;

      if (!productSlug || !productName || !productPrice || !productImage) return;

      window.dispatchEvent(
        new CustomEvent("cart:add", {
          detail: {
            slug: productSlug,
            name: productName,
            price: Number(productPrice),
            image: productImage,
          },
        }),
      );
    });
  });
</script>
