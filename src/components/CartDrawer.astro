<dialog
  id="cart-drawer"
  aria-labelledby="cart-drawer-title"
  class="fixed inset-y-0 right-0 m-0 ml-auto h-dvh max-h-none w-full max-w-md border-0 bg-transparent p-0"
>
  <div class="cart-panel flex h-full flex-col bg-white shadow-2xl">
    <div class="flex items-center justify-between border-b border-slate-200 px-6 py-5">
      <div>
        <p
          class="text-[10px] font-semibold uppercase tracking-[0.2em] text-violet-600"
        >
          Reboot Lab
        </p>
        <h2
          id="cart-drawer-title"
          class="mt-1 text-2xl font-bold tracking-tight text-slate-950"
        >
          Your cart
        </h2>
      </div>

      <button
        type="button"
        data-cart-close
        aria-label="Close cart"
        class="flex size-10 items-center justify-center rounded-full border border-slate-200 text-xl text-slate-500 transition hover:border-violet-300 hover:bg-violet-50 hover:text-violet-600"
      >
        ×
      </button>
    </div>

    <div
      data-cart-empty
      class="flex flex-1 flex-col items-center justify-center px-8 py-12 text-center"
    >
      <span
        class="flex size-20 items-center justify-center rounded-full bg-violet-50 text-violet-600"
      >
        <svg
          viewBox="0 0 24 24"
          class="size-9"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M5 8h14l-1 13H6z"></path>
          <path d="M9 10V6a3 3 0 0 1 6 0v4"></path>
        </svg>
      </span>

      <h3 class="mt-6 text-2xl font-bold tracking-tight text-slate-950">
        Your cart is empty
      </h3>
      <p class="mt-3 max-w-xs text-sm leading-6 text-slate-500">
        Give reliable hardware another cycle. Explore our refurbished products
        and add your first item.
      </p>

      <button
        type="button"
        data-cart-close
        class="mt-7 rounded-xl bg-violet-600 px-6 py-3 text-sm font-semibold text-white transition hover:bg-violet-700"
      >
        Continue shopping
      </button>
    </div>

    <div data-cart-items class="hidden flex-1 overflow-y-auto px-6 py-3"></div>

    <div class="border-t border-slate-200 bg-slate-50 px-6 py-6">
      <div class="flex items-center justify-between">
        <div>
          <p
            class="text-[10px] font-semibold uppercase tracking-[0.18em] text-slate-400"
          >
            Subtotal
          </p>
          <p class="mt-1 text-xs text-slate-500">Taxes calculated at checkout</p>
        </div>
        <p data-cart-subtotal class="text-2xl font-bold text-slate-950">CHF 0</p>
      </div>

      <button
        type="button"
        data-cart-checkout
        disabled
        class="mt-5 flex w-full cursor-not-allowed items-center justify-between rounded-xl bg-slate-200 px-5 py-4 text-sm font-semibold text-slate-400"
      >
        <span>Checkout</span>
        <span>→</span>
      </button>

      <div
        class="mt-4 flex items-center justify-center gap-2 text-[10px] font-medium uppercase tracking-[0.14em] text-slate-400"
      >
        <span class="size-1.5 rounded-full bg-emerald-500"></span>
        Secure checkout
      </div>
    </div>
  </div>
</dialog>

<script>
  import type { CartItem } from "../types/cart";
  import { withBasePath } from "../utils/paths";

  const CART_STORAGE_KEY = "reboot-lab-cart";
  const cartDrawer = document.querySelector<HTMLDialogElement>("#cart-drawer");
  const openButtons = document.querySelectorAll<HTMLElement>("[data-cart-open]");
  const closeButtons = document.querySelectorAll<HTMLElement>("[data-cart-close]");
  const countBadges = document.querySelectorAll<HTMLElement>("[data-cart-count]");
  const emptyState = cartDrawer?.querySelector<HTMLElement>("[data-cart-empty]");
  const itemsContainer = cartDrawer?.querySelector<HTMLElement>("[data-cart-items]");
  const subtotalElement = cartDrawer?.querySelector<HTMLElement>("[data-cart-subtotal]");
  const checkoutButton = cartDrawer?.querySelector<HTMLButtonElement>("[data-cart-checkout]");
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
  let cartCloseTimer: number | undefined;

  const currency = new Intl.NumberFormat("de-CH", {
    style: "currency",
    currency: "CHF",
    maximumFractionDigits: 2,
  });

  function readCart(): CartItem[] {
    try {
      const storedCart = JSON.parse(localStorage.getItem(CART_STORAGE_KEY) ?? "[]");
      return Array.isArray(storedCart) ? storedCart : [];
    } catch {
      return [];
    }
  }

  function writeCart(cart: CartItem[]) {
    localStorage.setItem(CART_STORAGE_KEY, JSON.stringify(cart));
    renderCart(cart);
  }

  function createCartItem(item: CartItem) {
    const article = document.createElement("article");
    article.className = "flex gap-4 border-b border-slate-200 py-5";

    const imageLink = document.createElement("a");
    imageLink.href = withBasePath(`/products/${encodeURIComponent(item.slug)}`);
    imageLink.className = "size-24 shrink-0 overflow-hidden rounded-xl bg-slate-100";

    const image = document.createElement("img");
    image.src = item.image;
    image.alt = item.name;
    image.className = "size-full object-cover";
    imageLink.append(image);

    const information = document.createElement("div");
    information.className = "min-w-0 flex-1";

    const nameLink = document.createElement("a");
    nameLink.href = imageLink.href;
    nameLink.textContent = item.name;
    nameLink.className = "block truncate text-sm font-bold text-slate-950 hover:text-violet-600";

    const price = document.createElement("p");
    price.textContent = currency.format(item.price);
    price.className = "mt-1 text-sm font-semibold text-violet-600";

    const controls = document.createElement("div");
    controls.className = "mt-4 flex items-center justify-between gap-3";

    const quantity = document.createElement("span");
    quantity.textContent = `Quantity: ${item.quantity}`;
    quantity.className = "text-xs font-medium text-slate-500";

    const removeButton = document.createElement("button");
    removeButton.type = "button";
    removeButton.textContent = "Remove";
    removeButton.className = "text-xs font-semibold text-red-500 transition hover:text-red-700";
    removeButton.setAttribute("aria-label", `Remove ${item.name} from cart`);
    removeButton.addEventListener("click", () => {
      writeCart(readCart().filter((cartItem) => cartItem.slug !== item.slug));
      window.dispatchEvent(
        new CustomEvent("reboot:notify", {
          detail: {
            type: "info",
            message: "Product removed from your cart.",
          },
        }),
      );
    });

    controls.append(quantity, removeButton);
    information.append(nameLink, price, controls);
    article.append(imageLink, information);

    return article;
  }

  function renderCart(cart = readCart()) {
    const totalQuantity = cart.reduce((total, item) => total + item.quantity, 0);
    const subtotal = cart.reduce((total, item) => total + item.price * item.quantity, 0);

    countBadges.forEach((badge) => {
      badge.textContent = String(totalQuantity);
      badge.setAttribute("aria-label", `${totalQuantity} items in cart`);
    });

    emptyState?.classList.toggle("hidden", cart.length > 0);
    itemsContainer?.classList.toggle("hidden", cart.length === 0);

    if (itemsContainer) {
      itemsContainer.replaceChildren(...cart.map(createCartItem));
    }

    if (subtotalElement) subtotalElement.textContent = currency.format(subtotal);

    if (checkoutButton) {
      checkoutButton.disabled = cart.length === 0;
      checkoutButton.className = cart.length === 0
        ? "mt-5 flex w-full cursor-not-allowed items-center justify-between rounded-xl bg-slate-200 px-5 py-4 text-sm font-semibold text-slate-400"
        : "mt-5 flex w-full items-center justify-between rounded-xl bg-violet-600 px-5 py-4 text-sm font-semibold text-white transition hover:bg-violet-700";
    }
  }

  function openCart() {
    if (!cartDrawer) return;

    if (cartCloseTimer) {
      window.clearTimeout(cartCloseTimer);
      cartCloseTimer = undefined;
    }

    if (cartDrawer.open) {
      cartDrawer.classList.add("is-visible");
      return;
    }

    cartDrawer.showModal();
    window.requestAnimationFrame(() => {
      window.requestAnimationFrame(() => {
        cartDrawer.classList.add("is-visible");
      });
    });
  }

  function closeCart() {
    if (!cartDrawer?.open) return;

    cartDrawer.classList.remove("is-visible");

    if (reduceMotion.matches) {
      cartDrawer.close();
      return;
    }

    if (cartCloseTimer) window.clearTimeout(cartCloseTimer);
    cartCloseTimer = window.setTimeout(() => {
      cartDrawer.close();
      cartCloseTimer = undefined;
    }, 460);
  }

  openButtons.forEach((button) => {
    button.addEventListener("click", openCart);
  });

  closeButtons.forEach((button) => {
    button.addEventListener("click", closeCart);
  });

  cartDrawer?.addEventListener("click", (event) => {
    if (event.target === cartDrawer) closeCart();
  });

  cartDrawer?.addEventListener("cancel", (event) => {
    event.preventDefault();
    closeCart();
  });

  checkoutButton?.addEventListener("click", () => {
    if (readCart().length === 0) return;
    closeCart();
    window.setTimeout(
      () => window.dispatchEvent(new CustomEvent("checkout:open")),
      reduceMotion.matches ? 0 : 420,
    );
  });

  window.addEventListener("cart:add", (event) => {
    const product = (event as CustomEvent<Omit<CartItem, "quantity">>).detail;
    const cart = readCart();
    const existingItem = cart.find((item) => item.slug === product.slug);

    if (existingItem) {
      existingItem.quantity += 1;
    } else {
      cart.push({ ...product, quantity: 1 });
    }

    writeCart(cart);
    openCart();
    window.dispatchEvent(
      new CustomEvent("reboot:notify", {
        detail: {
          type: "success",
          message: existingItem
            ? "Product quantity updated."
            : "Product added to your cart.",
        },
      }),
    );
  });

  window.addEventListener("cart:open", openCart);
  window.addEventListener("storage", () => renderCart());
  renderCart();
</script>

<style>
  #cart-drawer .cart-panel {
    transform: translateX(calc(100% + 1rem));
    transition: transform 460ms cubic-bezier(0.25, 0.1, 0.25, 1);
    will-change: transform;
  }

  #cart-drawer.is-visible .cart-panel {
    transform: translateX(0);
  }

  #cart-drawer::backdrop {
    background-color: rgb(15 23 42 / 0%);
    transition: background-color 420ms ease;
  }

  #cart-drawer.is-visible::backdrop {
    background-color: rgb(15 23 42 / 60%);
  }

  @media (prefers-reduced-motion: reduce) {
    #cart-drawer .cart-panel,
    #cart-drawer::backdrop {
      transition: none;
    }
  }
</style>
