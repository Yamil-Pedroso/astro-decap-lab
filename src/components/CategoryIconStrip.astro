---
import { getCollection, getEntry } from "astro:content";
import { createCategoryIconItems } from "../data/category-icons";

const [productEntries, categoryEntries, page] = await Promise.all([
  getCollection("products"),
  getCollection("categories"),
  getEntry("pages", "home"),
]);
if (!page || page.data.template !== "home") throw new Error("Home content not found");
const products = productEntries.map((entry) => ({
  slug: entry.id,
  ...entry.data,
}));
const categories = categoryEntries
  .map((entry) => ({ slug: entry.id, ...entry.data }))
  .sort((a, b) => a.order - b.order);
const categoryIconItems = createCategoryIconItems(categories, products);
---

<section class="mt-6" aria-labelledby="category-strip-title">
  <h2 id="category-strip-title" class="sr-only">{page.data.categoryStripTitle}</h2>

  <div class="flex snap-x snap-mandatory overflow-x-auto">
    {
        categoryIconItems.map((category) => (
        <a
          href={`/categories/${category.slug}`}
          class="group flex min-w-36 flex-1 snap-start flex-col items-center px-5 py-6 text-center transition duration-300 hover:bg-violet-50/70 focus-visible:bg-violet-50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-violet-500"
        >
          <span class="flex size-14 items-center justify-center rounded-full bg-slate-50 text-slate-800 transition duration-300 group-hover:bg-violet-600 group-hover:text-white">
            <svg
              viewBox="0 0 24 24"
              class="size-7"
              fill="none"
              stroke="currentColor"
              stroke-width="1.7"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              {category.paths.map((path) => <path d={path} />)}
            </svg>
          </span>

          <h3 class="mt-3 text-sm font-semibold text-slate-950">
            {category.name}
          </h3>

          <p class="mt-1 text-xs text-slate-400">
            {category.itemCount} {category.itemCount === 1 ? "item" : "items"}
          </p>
        </a>
      ))
    }
  </div>
</section>
