---
import { categories } from "../data/categories";
import { products } from "../data/products";

const icons: Record<string, string[]> = {
  laptops: [
    "M5 5h14a1 1 0 0 1 1 1v9H4V6a1 1 0 0 1 1-1Z",
    "M2.5 18h19",
    "M9 18h6",
  ],
  desktops: [
    "M4 4h10v11H4z",
    "M7 19h4",
    "M9 15v4",
    "M17 4h3v15h-3z",
    "M18.5 16h.01",
  ],
  monitors: [
    "M3 4h18v12H3z",
    "M8 20h8",
    "M12 16v4",
  ],
  components: [
    "M8 8h8v8H8z",
    "M9 2v3M12 2v3M15 2v3M9 19v3M12 19v3M15 19v3",
    "M2 9h3M2 12h3M2 15h3M19 9h3M19 12h3M19 15h3",
  ],
};

const categoryItems = categories.map((category) => ({
  ...category,
  itemCount: products.filter((product) => product.category === category.slug)
    .length,
}));
---

<section class="mt-6" aria-labelledby="category-strip-title">
  <h2 id="category-strip-title" class="sr-only">Product categories</h2>

  <div class="flex snap-x snap-mandatory overflow-x-auto">
    {
      categoryItems.map((category) => (
        <a
          href={`/categories/${category.slug}`}
          class="group flex min-w-36 flex-1 snap-start flex-col items-center px-5 py-6 text-center transition duration-300 hover:bg-violet-50/70 focus-visible:bg-violet-50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-violet-500"
        >
          <span class="flex size-14 items-center justify-center rounded-full bg-slate-50 text-slate-800 transition duration-300 group-hover:bg-violet-600 group-hover:text-white">
            <svg
              viewBox="0 0 24 24"
              class="size-7"
              fill="none"
              stroke="currentColor"
              stroke-width="1.7"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              {icons[category.slug]?.map((path) => <path d={path} />)}
            </svg>
          </span>

          <h3 class="mt-3 text-sm font-semibold text-slate-950">
            {category.name}
          </h3>

          <p class="mt-1 text-xs text-slate-400">
            {category.itemCount} {category.itemCount === 1 ? "item" : "items"}
          </p>
        </a>
      ))
    }
  </div>
</section>
