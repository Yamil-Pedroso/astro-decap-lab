---
const pathname = Astro.url.pathname;
const isShopActive =
	pathname === "/" || pathname.startsWith("/products");
const isCategoriesActive = pathname.startsWith("/categories");
const isAboutActive = pathname.startsWith("/about");
---

<header class="border-b border-slate-200 bg-white">
	<div
	class="mx-auto flex w-full max-w-[1600px] items-center justify-between px-4 py-4 sm:px-6 lg:px-8"
>
		<a href="/" class="text-xl font-bold tracking-tight text-slate-950">
			Reboot Lab
		</a>

		<nav class="hidden items-center gap-8 text-sm font-medium text-slate-600 md:flex">
			<a
				href="/"
				class:list={[
					"transition hover:text-violet-600",
					isShopActive && "text-violet-600",
				]}
				aria-current={isShopActive ? "page" : undefined}
			>
				Shop
			</a>

			<a
				href="/categories"
				class:list={[
					"transition hover:text-violet-600",
					isCategoriesActive && "text-violet-600",
				]}
				aria-current={isCategoriesActive ? "page" : undefined}
			>
				Categories
			</a>

			<a
				href="/about"
				class:list={[
					"transition hover:text-violet-600",
					isAboutActive && "text-violet-600",
				]}
				aria-current={isAboutActive ? "page" : undefined}
			>
				About
			</a>
		</nav>

		<div class="flex items-center gap-3">
			<button
				type="button"
				class="rounded-lg border border-slate-200 px-3 py-2 text-sm text-slate-600 transition hover:border-violet-300 hover:text-violet-600"
			>
				Search
			</button>

			<a
				href="/cart"
				class="rounded-lg bg-violet-600 px-4 py-2 text-sm font-semibold text-white transition hover:bg-violet-700"
			>
				Cart
			</a>
		</div>
	</div>
</header>
