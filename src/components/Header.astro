---
import { Image } from "astro:assets";
import assets from "../assets";
import CartDrawer from "./CartDrawer.astro";
import CheckoutModal from "./CheckoutModal.astro";
import SearchModal from "./SearchModal.astro";

const pathname = Astro.url.pathname;
const isShopActive =
	pathname === "/" || pathname.startsWith("/products");
const isCategoriesActive = pathname.startsWith("/categories");
const isAboutActive = pathname.startsWith("/about");
const isContactActive = pathname.startsWith("/contact");
---

<header class="border-b border-slate-200 bg-white">
	<div
	class="mx-auto flex w-full max-w-[1600px] items-center justify-between px-4 py-4 sm:px-6 lg:px-8"
>
		<a href="/" aria-label="Reboot Lab home" class="shrink-0">
			<Image
				src={assets.brandLogo}
				alt="Reboot Lab"
				class="h-20 w-auto"
			/>
		</a>

		<nav class="hidden items-center gap-8 text-sm font-medium text-slate-600 md:flex">
			<a
				href="/"
				class:list={[
					"transition hover:text-violet-600",
					isShopActive && "text-violet-600",
				]}
				aria-current={isShopActive ? "page" : undefined}
			>
				Shop
			</a>

			<a
				href="/categories"
				class:list={[
					"transition hover:text-violet-600",
					isCategoriesActive && "text-violet-600",
				]}
				aria-current={isCategoriesActive ? "page" : undefined}
			>
				Categories
			</a>

			<a
				href="/about"
				class:list={[
					"transition hover:text-violet-600",
					isAboutActive && "text-violet-600",
				]}
				aria-current={isAboutActive ? "page" : undefined}
			>
				About
			</a>

			<a
				href="/contact"
				class:list={[
					"transition hover:text-violet-600",
					isContactActive && "text-violet-600",
				]}
				aria-current={isContactActive ? "page" : undefined}
			>
				Contact
			</a>
		</nav>

		<div class="flex items-center gap-3">
			<button
				type="button"
				data-search-open
				aria-controls="search-modal"
				aria-haspopup="dialog"
				class="rounded-lg border border-slate-200 px-3 py-2 text-sm text-slate-600 transition hover:border-violet-300 hover:text-violet-600"
			>
				Search
			</button>

			<button
				type="button"
				data-cart-open
				aria-controls="cart-drawer"
				aria-haspopup="dialog"
				class="relative rounded-lg bg-violet-600 px-4 py-2 text-sm font-semibold text-white transition hover:bg-violet-700"
			>
				Cart
				<span
					data-cart-count
					class="absolute -right-2 -top-2 flex size-5 items-center justify-center rounded-full border-2 border-white bg-slate-950 text-[9px] text-white"
				>
					0
				</span>
			</button>
		</div>
	</div>
</header>

<CartDrawer />
<CheckoutModal />
<SearchModal />
