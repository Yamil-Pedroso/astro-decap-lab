---
interface Props {
  name: string;
  slug: string;
  description: string;
}

const { name, slug, description } = Astro.props;
---

<a
  href={`/categories/${slug}`}
  class="group relative overflow-hidden border border-slate-200 bg-white p-6 transition duration-300 hover:-translate-y-1 hover:border-violet-400"
>
  <div class="mb-10 flex items-center justify-between">
    <span class="text-xs font-semibold tracking-[0.2em] text-slate-400">
      CATEGORY
    </span>

    <span class="text-lg text-violet-600 transition group-hover:translate-x-1">
      →
    </span>
  </div>

  <h3 class="text-2xl font-semibold tracking-tight text-slate-950">
    {name}
  </h3>

  <p class="mt-3 max-w-sm text-sm leading-6 text-slate-500">
    {description}
  </p>

  <div class="mt-8 h-px w-full bg-slate-200"></div>

  <p
    class="mt-4 text-xs font-medium uppercase tracking-[0.18em] text-slate-400"
  >
    /{slug}
  </p>
</a>
