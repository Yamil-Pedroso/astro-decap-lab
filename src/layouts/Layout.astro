---
import "../styles/global.css";
import { withBasePath } from "../utils/paths";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ToastNotifications from "../components/ToastNotifications.astro";
import WelcomeNotice from "../components/WelcomeNotice.astro";

const { title = "Reboot Lab" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href={withBasePath("/favicon.svg")} />

    <title>{title}</title>
  </head>

  <body class="min-h-screen bg-slate-50 text-slate-950">
    <ToastNotifications />
    <Header />

    <main class="mx-auto w-full max-w-[1600px] px-4 sm:px-6 lg:px-8">
      <slot />
    </main>
    <Footer />
    <WelcomeNotice />
  </body>
</html>
